generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ¸ط¦â€™")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Neighborhood {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  city        String     @default("ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ±ط·آ¸ط¸آ¹ط·آ·ط¢آ§ط·آ·ط¢آ¶")
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  properties  Property[]
}

model Property {
  id             String         @id @default(cuid())
  title          String
  description    String
  price          Int
  area           Int
  bedrooms       Int?
  bathrooms      Int?
  propertyType   String
  listingType    String
  featured       Boolean        @default(false)
  phone          String?
  whatsapp       String?
  locationNote   String?
advertiserName String?
  ownerName      String?
  ownerPhone     String?
  views          Int      @default(0)
  latitude       Float?
  longitude      Float?
  neighborhoodId String
  neighborhood   Neighborhood   @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)
  images         PropertyImage[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  @@index([neighborhoodId, propertyType, listingType])
  @@index([featured])
}

model PropertyImage {
  id         String   @id @default(cuid())
  url        String
  sortOrder  Int      @default(0)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@index([propertyId, sortOrder])
}
