generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("المالك")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Neighborhood {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  city        String     @default("الرياض")
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  properties  Property[]
}

model Property {
  id             String         @id @default(cuid())
  title          String
  description    String
  price          Int
  area           Int
  bedrooms       Int?
  bathrooms      Int?
  propertyType   String
  listingType    String
  featured       Boolean        @default(false)
  phone          String?
  whatsapp       String?
  locationNote   String?
  advertiserName String?
  ownerName      String?
  ownerPhone     String?
  views          Int            @default(0)
  latitude       Float?
  longitude      Float?
  neighborhoodId String
  neighborhood   Neighborhood   @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)
  images         PropertyImage[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([neighborhoodId, propertyType, listingType])
  @@index([featured])
}

model PropertyImage {
  id         String   @id @default(cuid())
  url        String
  sortOrder  Int      @default(0)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([propertyId, sortOrder])
}

model SiteSettings {
  id                  String   @id @default(cuid())
  siteName            String   @default("الوتر المعماري")
  logoUrl             String?
  headline            String   @default("عقارك يبدأ من هنا")
  subheadline         String?
  description         String?
  heroImageUrl        String?
  primaryButtonText   String   @default("تصفح العقارات")
  primaryButtonUrl    String   @default("/properties")
  secondaryButtonText String   @default("تواصل معنا")
  secondaryButtonUrl  String   @default("#contact")
  phone               String?
  whatsapp            String?
  email               String?
  address             String?
  mapUrl              String?
  primaryColor        String   @default("#b8954a")
  secondaryColor      String   @default("#111111")
  showFeatured        Boolean  @default(true)
  showNeighborhoods   Boolean  @default(true)
  showAbout           Boolean  @default(true)
  showContact         Boolean  @default(true)
  footerText          String?
  instagram           String?
  snapchat            String?
  tiktok              String?
  updatedAt           DateTime @updatedAt
}
